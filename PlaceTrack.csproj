<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlaceTrack</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pomelo = the "adapter" that lets Entity Framework Core talk to MySQL.
         It brings EF Core 9 with it. EF Core 9 runs fine on .NET 10. -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

</Project>

@model List<StudentProfile>
@{
    ViewData["Title"] = "Students";
    var query = (string)ViewBag.Query;
}

<div class="page-head">
    <div>
        <h1>Students</h1>
        <p class="muted">@Model.Count students@(string.IsNullOrEmpty(query) ? "" : " match \"" + query + "\"").</p>
    </div>
    <form method="get" asp-action="Students" class="search-form">
        <input type="search" name="q" value="@query" placeholder="Search name, roll number or branch" aria-label="Search students" />
        <button type="submit" class="btn btn-ghost">Search</button>
    </form>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty"><h3>No students found</h3><p class="muted">Try a different name, roll number or branch.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Student</th><th>Branch</th><th>CGPA</th><th>Backlogs</th><th>Applications</th><th>Result</th></tr></thead>
                <tbody>
                @foreach (var s in Model)
                {
                    int offers = s.Applications.Count(a => a.Status == Statuses.Selected);
                    <tr>
                        <td><strong>@s.User.FullName</strong><br /><span class="muted small">@s.RollNo, @s.User.Email</span></td>
                        <td>@s.Branch</td>
                        <td>@s.Cgpa.ToString("0.00")</td>
                        <td>@s.Backlogs</td>
                        <td>@s.Applications.Count</td>
                        <td>
                            @if (offers > 0) { <span class="badge badge-selected">Placed (@offers offer@(offers > 1 ? "s" : ""))</span> }
                            else { <span class="muted small">No offer yet</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

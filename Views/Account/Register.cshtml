@model RegisterVM
@{
    ViewData["Title"] = "Create account";
}

<section class="auth auth-wide">
    <div class="auth-card">
        <h1>Create your student account</h1>
        <p class="muted">Your CGPA, backlogs and branch decide which drives you can apply to. Enter them honestly.</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <div class="form-grid">
                <div class="field span-2">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" autocomplete="name" />
                    <span asp-validation-for="FullName" class="error"></span>
                </div>

                <div class="field span-2">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" autocomplete="email" />
                    <span asp-validation-for="Email" class="error"></span>
                </div>

                <div class="field">
                    <label asp-for="RollNo"></label>
                    <input asp-for="RollNo" />
                    <span asp-validation-for="RollNo" class="error"></span>
                </div>

                <div class="field">
                    <label asp-for="Branch"></label>
                    <select asp-for="Branch" asp-items="@(new SelectList(Branches.All))">
                        <option value="">Choose branch</option>
                    </select>
                    <span asp-validation-for="Branch" class="error"></span>
                </div>

                <div class="field">
                    <label asp-for="Cgpa">CGPA</label>
                    <input asp-for="Cgpa" type="number" step="0.01" min="0" max="10" />
                    <span asp-validation-for="Cgpa" class="error"></span>
                </div>

                <div class="field">
                    <label asp-for="Backlogs"></label>
                    <input asp-for="Backlogs" type="number" min="0" max="20" />
                    <span asp-validation-for="Backlogs" class="error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="error"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Create account</button>
        </form>

        <p class="muted small">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</section>
